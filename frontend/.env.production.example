# CampusFlow Frontend — PRODUCTION environment template.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.

NEXT_PUBLIC_API_URL=https://api.campusflow.app
NEXT_PUBLIC_APP_DOMAIN=campusflow.app
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Error tracking ──
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXX
# Build-time only (source-map upload). Optional; leave blank to skip upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
