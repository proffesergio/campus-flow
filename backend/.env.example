# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusflow"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_64_chars_minimum
JWT_REFRESH_SECRET=your_refresh_secret_64_chars_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — your Next.js frontend URL
FRONTEND_URL=http://localhost:3000
APP_DOMAIN=campusflow.app

# Stripe (international payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# SSLCommerz (Bangladesh local payments)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Anthropic Claude (report narratives, summaries)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT-4o (student study assistant, admin queries)
OPENAI_API_KEY=sk-...

# Resend (transactional email)
RESEND_API_KEY=re_...
EMAIL_FROM=CampusFlow <noreply@campusflow.app>

# Twilio (SMS alerts)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+1...

# File uploads (DigitalOcean Spaces in prod, local disk in dev)
UPLOAD_STORAGE=local
DO_SPACES_KEY=...
DO_SPACES_SECRET=...
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=campusflow-uploads
DO_SPACES_CDN_URL=https://campusflow-uploads.nyc3.cdn.digitaloceanspaces.com
