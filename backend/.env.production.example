# CampusFlow Backend — PRODUCTION environment template.
# Do NOT commit the real .env.production. Set these in your host's secret store
# (DigitalOcean App Platform / AWS Secrets Manager / Docker secrets / etc.).

NODE_ENV=production
PORT=3001

# ── Database (managed Postgres with encryption-at-rest + daily backups) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/campusflow?sslmode=require

# ── JWT (generate each: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=__64_char_random_hex__
JWT_REFRESH_SECRET=__64_char_random_hex__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs / tenancy ──
FRONTEND_URL=https://app.campusflow.app
APP_DOMAIN=campusflow.app
API_BASE_URL=https://api.campusflow.app   # used for the SSLCommerz IPN callback URL

# ── Error tracking ──
SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXX

# ── Payments: SSLCommerz (covers bKash / Nagad / cards in Bangladesh) ──
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_IS_LIVE=true
# Stripe (optional, international cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Notifications ──
RESEND_API_KEY=
EMAIL_FROM=CampusFlow <noreply@campusflow.app>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
